{
  "name": "string-catalog-cli",
  "version": "1.1.0",
  "type": "module",
  "description": "CLI for managing Xcode String Catalog (.xcstrings) files",
  "bin": {
    "xcstrings": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && bun build src/cli/index.ts --outdir dist/cli --target node --format esm",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "xcode",
    "string-catalog",
    "xcstrings",
    "localization",
    "i18n",
    "cli"
  ],
  "author": "Khoa Pham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmyway133/string-catalog-cli.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
